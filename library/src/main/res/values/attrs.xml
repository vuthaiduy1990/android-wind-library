<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Common attributes -->
    <attr name="text" format="string" />
    <attr name="hint" format="string" />
    <attr name="textSize" format="dimension" />
    <attr name="textColor" format="color" />
    <attr name="iconSize" format="dimension" />
    <attr name="spacing" format="dimension" />

    <!-- Checkbox's attributes -->
    <!-- Should have the same name with View class so that the Android hint can work in layout resource file -->
    <declare-styleable name="Checkbox">
        <attr name="animType" format="enum">
            <enum name="DEFAULT_CIRCLE" value="0" />
            <enum name="TAKAYA_DEGUCHI_1" value="1" />
            <enum name="TAKAYA_DEGUCHI_2" value="2" />
            <enum name="VICTOR_KAI" value="3" />
            <enum name="LORIN" value="4" />
            <enum name="DARIUS_AFCHAR" value="5" />
            <enum name="GILSON_SANTOS_1" value="6" />
            <enum name="GILSON_SANTOS_2" value="7" />
            <enum name="AVIRAL_BAHUGUNA" value="8" />
            <enum name="DEFAULT_SQUARE" value="9" />
            <enum name="DEFAULT_CHECKLIST" value="10" />
        </attr>
        <attr name="animColor" format="color" />
        <attr name="checked" format="boolean" />
        <attr name="enabled" format="boolean" />
    </declare-styleable>

    <!-- Button's attributes -->
    <!-- Should have the same name with View class so that the Android hint can work in layout resource file -->
    <declare-styleable name="Button">
        <attr name="type" format="enum">
            <enum name="PRIMARY" value="0" />
            <enum name="PRIMARY_LIGHT" value="1" />
            <enum name="SUCCESS" value="2" />
            <enum name="SUCCESS_LIGHT" value="3" />
            <enum name="INFO" value="4" />
            <enum name="INFO_LIGHT" value="5" />
            <enum name="HIGHLIGHT" value="6" />
            <enum name="HIGHLIGHT_LIGHT" value="7" />
            <enum name="WARNING" value="8" />
            <enum name="WARNING_LIGHT" value="9" />
            <enum name="DANGER" value="10" />
            <enum name="DANGER_LIGHT" value="11" />
            <enum name="GRAY" value="12" />
            <enum name="GRAY_LIGHT" value="13" />
            <enum name="NEUTRAL" value="14" />
            <enum name="NEUTRAL_LIGHT" value="15" />
        </attr>
        <attr name="customIcon" format="reference" />
        <attr name="customAnim" format="reference" />
        <attr name="iconSize" />
        <attr name="inlineIcon" format="enum">
            <enum name="OK" value="0" />
            <enum name="EDIT" value="1" />
            <enum name="SAVE" value="2" />
            <enum name="TRASH" value="3" />
            <enum name="WAITING" value="4" />
            <enum name="SEARCH" value="5" />
            <enum name="INFO" value="6" />
            <enum name="LOCK" value="7" />
            <enum name="SETTING" value="8" />
        </attr>
        <attr name="text" />
        <attr name="textColor" />
        <attr name="textSize" />
        <attr name="spacing" />
    </declare-styleable>

    <!--  SearchBox attributes-->
    <declare-styleable name="SearchBox">
        <attr name="text" />
        <attr name="hint" />
        <attr name="textSize" />
        <attr name="iconSize" />
        <attr name="searchIcon" format="reference" />
        <attr name="resultCountVisible" format="boolean" />
        <attr name="closeVisible" format="boolean" />
        <attr name="compactMode" format="boolean" />
        <attr name="closeKeyboardOnSearch" format="boolean" />
        <attr name="lazyTime" format="integer" />

    </declare-styleable>

    <!--  TagBox attributes -->
    <declare-styleable name="TagBox">
        <attr name="textSize" />
        <attr name="textColor" />
        <attr name="textMaxWidth" format="dimension" />
        <attr name="iconSize" />
        <attr name="removeIcon" format="reference" />
    </declare-styleable>

    <!--  Calendar attributes -->
    <declare-styleable name="WindCalendar">
        <attr name="tagCode" format="string" />
        <attr name="offscreen" format="integer" />

        <attr name="weekDays" format="string" />
        <attr name="weekDayTextSize" format="dimension" />
        <attr name="weekDayTextColor" format="color" />
        <attr name="weekDayPanelBackground" format="reference" />
        <attr name="weekDayHoverBackground" format="reference" />

        <attr name="dateCellSize" format="dimension" />
        <attr name="dateTextSize" format="dimension" />
        <attr name="dateLunarTextSize" format="dimension" />
        <attr name="dateEventSymbolSize" format="dimension" />

        <attr name="dateTextColor" format="color" />
        <attr name="dateLunarTextColor" format="color" />
        <attr name="dateEventTextColor" format="color" />
        <attr name="dateWeekendTextColor" format="color" />
        <attr name="dateTodayTextColor" format="color" />
        <attr name="dateHighlightTextColor" format="color" />
        <attr name="dateHighlightLunarTextColor" format="color" />

        <attr name="monthPanelViewBackground" format="reference" />
        <attr name="dateCellBackground" format="reference" />
        <attr name="dateEventBackground" format="reference" />
        <attr name="dateWeekendBackground" format="reference" />
        <attr name="dateTodayBackground" format="reference" />
        <attr name="dateHighlightBackground" format="reference" />

        <attr name="lunar" format="enum">
            <enum name="Buddhist" value="0" />
            <enum name="Chinese" value="1" />
            <enum name="Coptic" value="2" />
            <enum name="Hebrew" value="3" />
            <enum name="Indian" value="4" />
            <enum name="Islamic" value="5" />
            <enum name="Japanese" value="6" />
            <enum name="Taiwan" value="7" />
            <enum name="Vietnamese" value="8" />
        </attr>

        <attr name="weekStartsOn" format="enum">
            <enum name="MONDAY" value="2" />
            <enum name="SATURDAY" value="7" />
            <enum name="SUNDAY" value="1" />
        </attr>

        <attr name="autoBuild" format="boolean" />

    </declare-styleable>
</resources>