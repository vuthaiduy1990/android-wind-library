<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Checkbox's attributes -->
    <declare-styleable name="wl_checkbox">
        <attr name="animType" format="enum">
            <enum name="DEFAULT_CIRCLE" value="0" />
            <enum name="TAKAYA_DEGUCHI_1" value="1" />
            <enum name="TAKAYA_DEGUCHI_2" value="2" />
            <enum name="VICTOR_KAI" value="3" />
            <enum name="LORIN" value="4" />
            <enum name="DARIUS_AFCHAR" value="5" />
            <enum name="GILSON_SANTOS_1" value="6" />
            <enum name="GILSON_SANTOS_2" value="7" />
            <enum name="AVIRAL_BAHUGUNA" value="8" />
            <enum name="DEFAULT_SQUARE" value="9" />
            <enum name="DEFAULT_CHECKLIST" value="10" />
        </attr>
        <attr name="animColor" format="color" />
    </declare-styleable>

    <!-- Button's attributes -->
    <declare-styleable name="wl_button">
        <attr name="type" format="enum">
            <enum name="PRIMARY" value="0" />
            <enum name="SUCCESS" value="1" />
            <enum name="INFO" value="2" />
            <enum name="HIGHLIGHT" value="3" />
            <enum name="WARNING" value="4" />
            <enum name="DANGER" value="5" />
            <enum name="GRAY" value="6" />
            <enum name="NEUTRAL" value="7" />
        </attr>
        <attr name="customIcon" format="reference" />
        <attr name="customAnim" format="reference" />
        <attr name="iconSize" format="dimension" />
        <attr name="inlineIcon" format="enum">
            <enum name="OK" value="0" />
            <enum name="EDIT" value="1" />
            <enum name="SAVE" value="2" />
            <enum name="TRASH" value="3" />
            <enum name="WAITING" value="4" />
            <enum name="SEARCH" value="5" />
            <enum name="INFO" value="6" />
            <enum name="LOCK" value="7" />
            <enum name="SETTING" value="8" />
        </attr>
        <attr name="text" format="string" />
        <attr name="textColor" format="color" />
        <attr name="textSize" format="dimension" />
        <attr name="spacing" format="dimension" />
    </declare-styleable>
</resources>