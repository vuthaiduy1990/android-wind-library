<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/wl_action_menu_item_margin_ver"
    android:layout_marginBottom="@dimen/wl_action_menu_item_margin_ver"
    android:background="@drawable/wl_action_menu_item_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="@dimen/wl_padding_hoz_big"
    android:paddingTop="@dimen/wl_padding_ver_big"
    android:paddingEnd="@dimen/wl_padding_hoz_big"
    android:paddingBottom="@dimen/wl_padding_ver_big">

    <ImageView
        android:id="@+id/_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/wl_spacing_double"
        android:layout_weight="0"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/wl_spacing_double"
        android:layout_weight="1"
        android:background="@color/transparent"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:textColor="#000000"
        tools:ignore="LabelFor" />

</LinearLayout>