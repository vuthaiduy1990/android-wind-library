<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/wl_spacing_level_3"
    android:paddingTop="@dimen/wl_spacing_level_1"
    android:paddingEnd="@dimen/wl_spacing_level_3"
    android:paddingBottom="@dimen/wl_spacing_level_1">

    <ImageView
        android:id="@+id/_iconView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/wl_spacing_level_0"
        android:background="@color/wl_transparent"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:textColor="#000000"
        tools:ignore="LabelFor" />

</LinearLayout>