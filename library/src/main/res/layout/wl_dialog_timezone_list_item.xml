<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="@dimen/wl_spacing_level_2"
    android:paddingTop="@dimen/wl_spacing_level_1"
    android:paddingEnd="@dimen/wl_spacing_level_2"
    android:paddingBottom="@dimen/wl_spacing_level_1">

    <the.wind.library.view.Checkbox
        android:id="@+id/_checkbox"
        android:layout_width="@dimen/wl_icon_big"
        android:layout_height="@dimen/wl_icon_big"
        android:layout_marginEnd="@dimen/wl_spacing_level_1"
        android:layout_weight="0"
        app:animColor="@color/wl_success"
        app:animType="LORIN" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/wl_spacing_level_3"
        android:paddingTop="@dimen/wl_spacing_level_1"
        android:paddingEnd="@dimen/wl_spacing_level_3"
        android:paddingBottom="@dimen/wl_spacing_level_1">

        <TextView
            android:id="@+id/_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:textColor="@color/wl_text"
            android:textSize="@dimen/wl_text_small" />

        <TextView
            android:id="@+id/_offsetView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:textColor="@color/wl_text_hint"
            android:textSize="@dimen/wl_text_tiny" />

        <TextView
            android:id="@+id/_locationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:textColor="@color/wl_text_hint"
            android:textSize="@dimen/wl_text_tiny" />

    </LinearLayout>

</LinearLayout>