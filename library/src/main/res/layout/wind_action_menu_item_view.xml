<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/wind_action_menu_item_margin_ver"
    android:layout_marginBottom="@dimen/wind_action_menu_item_margin_ver"
    android:background="@drawable/wind_action_menu_item_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="@dimen/wind_action_menu_item_padding_hoz"
    android:paddingTop="@dimen/wind_action_menu_item_padding_ver"
    android:paddingEnd="@dimen/wind_action_menu_item_padding_hoz"
    android:paddingBottom="@dimen/wind_action_menu_item_padding_ver">

    <ImageView
        android:id="@+id/_icon"
        android:layout_width="@dimen/wind_action_menu_icon_size"
        android:layout_height="@dimen/wind_action_menu_icon_size"
        android:layout_marginEnd="@dimen/wind_action_menu_item_spacing"
        android:layout_weight="0"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/wind_action_menu_item_spacing"
        android:layout_weight="1"
        android:background="@color/transparent"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:textColor="#000000"
        android:textSize="@dimen/wind_action_menu_text_size"
        tools:ignore="LabelFor" />

</LinearLayout>