<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Main Content View -->
    <LinearLayout
        android:id="@+id/_layout"
        android:layout_width="@dimen/wl_dialog_tatsumaki_width"
        android:layout_height="wrap_content"
        android:background="@drawable/wl_dialog_background"
        android:gravity="center"
        android:orientation="vertical">

        <!-- icon -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Static Icon -->
            <ImageView
                android:id="@+id/_icon"
                android:layout_width="@dimen/wl_dialog_tatsumaki_icon_size"
                android:layout_height="@dimen/wl_dialog_tatsumaki_icon_size"
                android:layout_centerInParent="true"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:ignore="ContentDescription" />

            <!-- Animation Icon -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/_lottieIcon"
                android:layout_width="@dimen/wl_dialog_tatsumaki_icon_size"
                android:layout_height="@dimen/wl_dialog_tatsumaki_icon_size"
                android:layout_centerInParent="true"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:lottie_autoPlay="true"
                app:lottie_loop="false" />

        </RelativeLayout>

        <!-- title -->
        <TextView
            android:id="@+id/_tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/wl_dialog_tatsumaki_title_margin_top"
            android:gravity="center"
            android:textColor="@color/wl_dialog_title"
            android:textSize="@dimen/wl_dialog_tatsumaki_title_size" />

        <!-- Custom Content Body -->
        <!-- The use can customize this content view -->
        <RelativeLayout
            android:id="@+id/_bodyHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/wl_dialog_tatsumaki_body_margin_top">

        </RelativeLayout>

        <!-- footer -->
        <LinearLayout
            android:id="@+id/_footerHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/wl_dialog_footer_margin_top"
            android:gravity="center"
            android:orientation="horizontal">

        </LinearLayout>

    </LinearLayout>

    <!-- Waiting View -->
    <RelativeLayout
        android:id="@+id/_waitingMask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/wl_dialog_waiting_mask"
        android:visibility="gone">

        <!-- Animation Icon -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/_waitingIcon"
            android:layout_width="@dimen/wl_dialog_tatsumaki_icon_size"
            android:layout_height="@dimen/wl_dialog_tatsumaki_icon_size"
            android:layout_centerInParent="true"
            android:scaleType="centerInside"
            app:lottie_autoPlay="false"
            app:lottie_loop="true" />

    </RelativeLayout>

</RelativeLayout>