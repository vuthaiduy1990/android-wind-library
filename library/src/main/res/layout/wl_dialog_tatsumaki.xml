<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Main Content View -->
    <LinearLayout
        android:id="@+id/_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/wl_dialog_background"
        android:gravity="center"
        android:orientation="vertical">

        <!-- header -->
        <RelativeLayout
            android:id="@+id/_headerHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Static Icon -->
            <ImageView
                android:id="@+id/_iconView"
                android:layout_width="@dimen/wl_dialog_tatsumaki_icon_size"
                android:layout_height="@dimen/wl_dialog_tatsumaki_icon_size"
                android:layout_centerInParent="true"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:ignore="ContentDescription" />

            <!-- Animation Icon -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/_lottieIconView"
                android:layout_width="@dimen/wl_dialog_tatsumaki_icon_size"
                android:layout_height="@dimen/wl_dialog_tatsumaki_icon_size"
                android:layout_centerInParent="true"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:lottie_autoPlay="true"
                app:lottie_loop="false" />

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/_titleLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/wl_spacing_level_2"
            android:gravity="center"
            android:orientation="vertical">

            <!-- title -->
            <TextView
                android:id="@+id/_titleView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/wl_dialog_title"
                android:textSize="@dimen/wl_title" />

            <!-- just empty since tatsumaki layout don't need sub title -->
            <TextView
                android:id="@+id/_subTitleView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Custom Content Body -->
        <!-- The use can customize this content view -->
        <RelativeLayout
            android:id="@+id/_bodyHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/wl_spacing_level_1">

        </RelativeLayout>

        <!-- footer -->
        <LinearLayout
            android:id="@+id/_footerHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/wl_dialog_footer_margin_top"
            android:gravity="center"
            android:orientation="horizontal">

        </LinearLayout>

    </LinearLayout>

    <!-- Waiting View -->
    <RelativeLayout
        android:id="@+id/_waitingMask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/wl_dialog_waiting_mask"
        android:visibility="gone">

        <!-- Animation Icon -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/_waitingIcon"
            android:layout_width="@dimen/wl_dialog_tatsumaki_icon_size"
            android:layout_height="@dimen/wl_dialog_tatsumaki_icon_size"
            android:layout_centerInParent="true"
            android:scaleType="centerInside"
            app:lottie_autoPlay="false"
            app:lottie_loop="true" />

    </RelativeLayout>

</RelativeLayout>