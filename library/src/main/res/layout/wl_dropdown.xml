<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <Spinner
        android:id="@+id/_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:background="@color/wl_transparent"
        android:gravity="start|center_vertical"
        android:paddingStart="0dp"
        android:paddingEnd="@dimen/wl_icon_small"
        android:spinnerMode="dropdown" />

    <ImageView
        android:id="@+id/_arrowIcon"
        android:layout_width="@dimen/wl_icon_tiny"
        android:layout_height="@dimen/wl_icon_tiny"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/wl_ic_arrow_down"
        tools:ignore="ContentDescription" />


</RelativeLayout>