<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start|center_vertical"
    android:paddingStart="@dimen/wl_spacing_level_3"
    android:paddingTop="@dimen/wl_spacing_level_2"
    android:paddingEnd="@dimen/wl_spacing_level_3"
    android:paddingBottom="@dimen/wl_spacing_level_2">

    <the.wind.library.view.Checkbox
        android:id="@+id/_checkbox"
        android:layout_width="@dimen/wl_icon_small"
        android:layout_height="@dimen/wl_icon_small"
        app:animColor="@color/wl_success"
        app:animType="LORIN"
        app:enabled="false" />

    <TextView
        android:id="@+id/_textView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/wl_spacing_level_2"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1" />

</LinearLayout>