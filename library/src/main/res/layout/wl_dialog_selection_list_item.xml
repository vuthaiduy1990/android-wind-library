<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="@dimen/wl_spacing_level_2"
    android:paddingTop="@dimen/wl_spacing_level_1"
    android:paddingEnd="@dimen/wl_spacing_level_2"
    android:paddingBottom="@dimen/wl_spacing_level_1">

    <the.wind.library.view.Checkbox
        android:id="@+id/_checkbox"
        android:layout_width="@dimen/wl_icon_big"
        android:layout_height="@dimen/wl_icon_big"
        android:layout_marginEnd="@dimen/wl_spacing_level_1"
        android:layout_weight="0"
        app:animColor="@color/wl_success"
        app:animType="LORIN" />

    <TextView
        android:id="@+id/_textView"
        style="@style/WL_DialogListItemTextTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

</LinearLayout>