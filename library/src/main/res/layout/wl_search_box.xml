<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/_rootView"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical|start"
    android:orientation="horizontal">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/_icCloseSearch"
        android:layout_width="@dimen/wl_icon"
        android:layout_height="@dimen/wl_icon"
        android:layout_marginEnd="@dimen/wl_spacing_level_2"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/wl_ic_search_close"
        tools:ignore="ContentDescription" />

    <!-- Search Box -->
    <LinearLayout
        android:id="@+id/_inputBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/_icSearchBtn"
            android:layout_width="@dimen/wl_icon_small"
            android:layout_height="@dimen/wl_icon_small"
            android:layout_marginStart="@dimen/wl_spacing_level_2"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/wl_ic_search"
            tools:ignore="ContentDescription" />

        <!--Text input-->
        <EditText
            android:id="@+id/_ipSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/wl_spacing_level_2"
            android:layout_marginEnd="@dimen/wl_spacing_level_2"
            android:layout_weight="1"
            android:background="@color/wl_transparent"
            android:gravity="center_vertical"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:minLines="1"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:scrollbars="none"
            android:singleLine="true"
            android:textColor="@color/wl_text"
            tools:ignore="LabelFor" />

        <TextView
            android:id="@+id/_searchResultCountView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/wl_spacing_level_2"
            android:textColor="@color/wl_text"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/_icClearSearch"
            android:layout_width="@dimen/wl_icon_small"
            android:layout_height="@dimen/wl_icon_small"
            android:layout_marginEnd="@dimen/wl_spacing_level_2"
            android:adjustViewBounds="true"
            android:padding="@dimen/wl_spacing_level_0"
            android:scaleType="fitCenter"
            android:src="@drawable/wl_ic_delete_across"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <!-- Search Icon -->
    <ImageView
        android:id="@+id/_icCompactSearch"
        android:layout_width="@dimen/wl_icon_big"
        android:layout_height="@dimen/wl_icon_big"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/wl_ic_search"
        tools:ignore="ContentDescription" />

</LinearLayout>