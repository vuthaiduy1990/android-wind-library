<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/_searchBoxLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingStart="@dimen/wl_spacing_level_2"
        android:paddingEnd="@dimen/wl_spacing_level_2">

        <!--  Compact Mode -->
        <the.wind.library.view.SearchBox
            android:id="@+id/_searchBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/wl_button_background_gray"
            android:gravity="end|center_vertical"
            app:compactMode="true"
            app:resultCountVisible="true" />

        <!--  Full search mode -->
        <the.wind.library.view.SearchBox
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/wl_button_background_gray"
            app:compactMode="false"
            app:resultCountVisible="true"
            app:text="Color the wind"
            app:textSize="@dimen/wl_text" />

        <!--  Full Search Mode without close icon -->
        <the.wind.library.view.SearchBox
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/wl_button_background_gray"
            app:closeVisible="false"
            app:compactMode="false" />

        <!--  Set padding for search input -->
        <the.wind.library.view.SearchBox
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/wl_button_background_gray"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            app:closeVisible="false"
            app:compactMode="false"
            app:iconSize="@dimen/wl_icon_big"
            app:searchIcon="@drawable/wl_ic_tag"
            app:textSize="@dimen/wl_title_big" />


    </LinearLayout>

</ScrollView>