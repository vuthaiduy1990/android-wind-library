<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <the.wind.library.view.Button
            android:id="@+id/_startTypingBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:text="Start"
            app:type="INFO" />

        <the.wind.library.view.Button
            android:id="@+id/_loopTypingBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/wl_spacing_level_2"
            app:text="Loop"
            app:type="NEUTRAL" />

        <the.wind.library.view.Button
            android:id="@+id/_stopTypingBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/wl_spacing_level_2"
            app:text="Stop"
            app:type="DANGER" />

    </LinearLayout>

    <TextView
        android:id="@+id/_textTypingView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/wl_spacing_level_1"
        android:text="Text typing fakulator demo"
        android:textColor="@color/wl_text"
        android:textSize="@dimen/wl_text" />

</LinearLayout>